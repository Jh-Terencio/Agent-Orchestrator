{
  "name": "agent-orchestrator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "node apps/server/dist/main.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
